# 监听地址与端口（容器内）
SERVER_HOST=0.0.0.0
SERVER_PORT=56001
# docker-compose 发布端口绑定的宿主地址。默认只绑本机，对外请走反向代理；
# 需要局域网直连时设为 0.0.0.0。
BIND_ADDRESS=127.0.0.1
SERVER_USERNAME=admin
# docker-compose 必填：未在 .env 设置 SERVER_PASSWORD 时 compose 会拒绝启动
SERVER_PASSWORD=replace-with-a-strong-password
DATA_DIR=./data
# WebUI 静态资源目录与在线更新写入的运行时目录。默认值适用于源码运行；
# docker 镜像内由 Dockerfile 设为 /app/runtime/static 与 /app/runtime。
# 改动这两个变量会直接影响在线更新能否工作，详见 docs/docker-online-update.md。
# STATIC_DIR=./static
# APP_RUNTIME_DIR=./runtime
# Docker WebUI 在线更新开关；新版镜像默认使用独立 runtime 持久化卷
SELF_UPDATE_ENABLED=true
# 在线更新二进制和 static 各自保留的回滚副本数（1-20）
SELF_UPDATE_BACKUP_RETENTION=3
# 自更新产物的 minisign 公钥（可选）。设置后**强制**要求 Release 附带 .minisig
# 签名文件，缺签名/验签失败都会中止更新；不设置则只校验 SHA256（无法证明真实性）。
# 推荐在**编译期**设置同名变量把它固化进二进制，而不是运行时配置——
# 运行时环境变量可以被能改配置的攻击者一并改掉。详见 docs/docker-online-update.md
# SELF_UPDATE_PUBLIC_KEY=replace-with-minisign-public-key
# 容器/进程时区（影响推送免打扰时段等基于本地时间的功能）
TZ=Asia/Shanghai

QUARK_COOKIE=
QUARK_SIGNIN_COOKIE=
QUARK_SIGNIN_ENABLED=false
QUARK_SIGNIN_HOUR=8
PANSOU_API_URL=

ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
ARIA2_SECRET=
ARIA2_MOVIE_DIR=/downloads/电影
ARIA2_SERIES_DIR=/downloads/连续剧
ARIA2_ANIME_DIR=/downloads/动画

TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN

# 企业微信机器人 webhook
# WECOM_BOT_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# WxPusher 推送
# WXPUSHER_APP_TOKEN=AT_xxxx
# WXPUSHER_UIDS=UID_xxx,UID_yyy

# Telegram 推送与受控控制 Bot（控制默认关闭）
# TELEGRAM_BOT_TOKEN=123456:xxxx
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_BOT_MODE=disabled  # disabled / long_polling / webhook
# TELEGRAM_BOT_ALLOWED_USER_IDS=123456789
# TELEGRAM_BOT_ALLOWED_CHAT_IDS=123456789
# TELEGRAM_BOT_PRIVATE_ONLY=true
# Webhook 模式另需以下三项；两个 Secret 至少 24 字符
# TELEGRAM_BOT_WEBHOOK_PUBLIC_URL=https://media.example.com
# TELEGRAM_BOT_WEBHOOK_PATH_SECRET=replace-with-random-path-secret
# TELEGRAM_BOT_WEBHOOK_SECRET=replace-with-random-header-secret

# Bark / Gotify / PushPlus / Server 酱
# BARK_URL=https://api.day.app/your_key
# GOTIFY_URL=https://gotify.example.com
# GOTIFY_TOKEN=your_token
# PUSHPLUS_TOKEN=your_token
# SERVERCHAN_KEY=your_key

# 自动备份：0 小时可关闭定时备份
BACKUP_INTERVAL_HOURS=24
BACKUP_VERIFY_INTERVAL_HOURS=24
# BACKUP_EXTERNAL_DIR=/mnt/offsite/my-media-sub
BACKUP_RETENTION=7
BACKUP_MAX_ARCHIVE_MB=256
BACKUP_MAX_STORAGE_MB=512

# Store 损坏隔离策略：默认中止启动（避免把损坏的业务 Store 静默换成空数据，
# 那会让服务"看起来正常"却丢光订阅/任务/通知）。确需"先把服务起来再手工修复"
# 时设为 true，届时会以警告级别提示当前处于降级状态。
# ALLOW_QUARANTINE_STARTUP=false

# 注：Host 白名单（allowed_hosts）只通过 WebUI 设置页配置，不支持环境变量——
# 与同类的高级网络设置 trust_proxy_headers 保持一致。

# Logging
RUST_LOG=info
LOG_FORMAT=text
SLOW_OPERATION_MS=1000

# Store lifecycle retention (bounded by built-in safety caps)
RETENTION_SUBSCRIPTION_CHECKS=30
RETENTION_SOURCE_SWITCHES=50
RETENTION_PREVIOUS_LINKS=50
RETENTION_NOTIFICATIONS=300
RETENTION_ACTIVE_JOBS=300
RETENTION_ARCHIVED_JOBS=5000
RETENTION_AUTOMATION_EVENTS=5000
RETENTION_AUTOMATION_DAYS=30
RETENTION_FAILED_AUTOMATION_DAYS=90
STORE_GROWTH_WARNING_MB=24
